# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional dedicated key for the REST admin API (`X-API-Key`).
# Falls back to BOT_TOKEN when unset (convenient for local/single-tenant use).
# Prefer a separate value in any internet-facing deploy.
# ADMIN_API_KEY=

# Bot mode: "webhook" (default, needs public HTTPS URL) or "polling" (local dev, no public URL).
# When polling, WEBHOOK_URL below is optional.
# BOT_MODE=polling

# Public HTTPS URL (required for BOT_MODE=webhook, optional for polling)
# Telegram will POST updates to: {WEBHOOK_URL}/webhook/{BOT_TOKEN}
# WEBHOOK_URL=https://your-vps.example.com

# SQLite database file path (created automatically on first run)
DATABASE_URL=sqlite:data.db

# Port for the Axum HTTP server
PORT=8080

# Seed this Telegram user as admin on first startup (optional)
# ADMIN_TELEGRAM_USER_ID=

# --- AI (Google Gemini / AI Studio) ---
# API token for AI features (ask, proactive messages, tool calling).
# Leave empty to disable AI features.
# GEMINI_API_TOKEN=
# Model ID (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
# Cheaper model used for conversation summarization when the context is too long
# (default: gemini-2.5-flash-lite).
# GEMINI_SUMMARIZE_MODEL=gemini-2.5-flash-lite
# Embedding model for RAG (default: gemini-embedding-2).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Rare coach image generate/edit (default: gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Max coach images per user per UTC day (default: 2).
# GEMINI_IMAGE_MAX_PER_USER_DAY=2
# Web search is enabled per user by the admin via /enablewebsearch.
# The seeded admin automatically has web search enabled.

# --- RAG (Retrieval Augmented Generation) ---
# Set to true to enable long-term memory retrieval from embedded conversations.
# RAG_ENABLED=false
# Number of semantically similar chunks to retrieve per query (default: 5).
# RAG_TOP_K=5

# --- Scheduler ---
# Interval in seconds between reminder scheduler checks (default: 60).
# REMINDER_CHECK_INTERVAL_SECS=60
# Interval in seconds between daily recap scheduler checks (default: 300).
# DAILY_RECAP_CHECK_INTERVAL_SECS=300
# Interval in seconds between nudge scheduler checks (default: 21600 = 6 hours).
# NUDGE_CHECK_INTERVAL_SECS=21600

# --- Logs (survives container/image restarts; stored in the SQLite file) ---
# Max /logs lines kept (default: 5000). Oldest rows are pruned.
# LOG_MAX_ENTRIES=5000
# Max /ai/logs traces kept (default: 200). Oldest traces are pruned.
# AI_LOG_MAX_ENTRIES=200

# --- Error automation (optional Cursor Automations webhook) ---
# Both values are required to enable the feature. When set, every ERROR log is
# POSTed so an agent can open a GitHub issue.
# ERROR_CURSOR_WEBHOOK_URL=
# ERROR_CURSOR_WEBHOOK_BEARER=
