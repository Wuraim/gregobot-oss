  "query": "\n        SELECT\n            gm.telegram_user_id,\n            u.username,\n            u.first_name\n        FROM group_members gm\n        LEFT JOIN users u ON u.telegram_user_id = gm.telegram_user_id\n        WHERE gm.chat_id = ?\n        ORDER BY gm.last_seen_at DESC\n        ",
