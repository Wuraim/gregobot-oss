  "query": "\n        SELECT c.role, c.content, c.created_at,\n               u.username AS username,\n               u.first_name AS first_name,\n               u.telegram_user_id AS telegram_user_id\n        FROM conversations c\n        LEFT JOIN users u ON u.id = c.user_id\n        WHERE c.chat_id = ?\n        ORDER BY c.id DESC\n        LIMIT ?\n        ",
