  "query": "\n            SELECT s.id, s.training_id, s.set_index, s.reps, s.weight_kg,\n                   e.slug AS exercise_slug\n            FROM training_strength_sets s\n            JOIN strength_exercises e ON e.id = s.exercise_id\n            WHERE s.training_id = ?\n            ORDER BY s.set_index ASC, s.id ASC\n            ",
